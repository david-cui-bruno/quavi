{
  "name": "quavi-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts",
    "emulators": "firebase emulators:start --only auth --project demo-quavi",
    "migrate:production": "node dist/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@google-cloud/bigquery": "^9.3.0",
    "@google-cloud/storage": "^8.4.0",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "firebase-tools": "^15.34.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
