{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "rootDir": "src", "outDir": "dist", "noUnusedLocals": true,
    "noUnusedParameters": true, "noEmitOnError": true
  },
  "include": ["src"]
}
